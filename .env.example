# Copy to .env and adjust:  cp .env.example .env
# .env is git-ignored — never commit real values.

# Used by the postgres container to create the database on first start
POSTGRES_USER=myday
POSTGRES_PASSWORD=change-me
POSTGRES_DB=myday

# Used by the app. "db" is the postgres service name in docker-compose.yml
DATABASE_URL=postgresql+psycopg://myday:change-me@db:5432/myday

LOG_LEVEL=info
